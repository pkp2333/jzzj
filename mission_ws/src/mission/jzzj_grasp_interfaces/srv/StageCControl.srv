# Each request is bound to one session and a monotonically increasing request_id.
uint8 TAKEOVER=0
uint8 CANCEL=1
uint8 HANDOFF_ACK=2
uint8 RECOVER=3
uint8 BASE_ACQUIRE=4
uint8 BASE_RELEASE=5
uint8 operation
string session_id
uint64 request_id
time issued_at
time expires_at
string next_owner
bool confirmed_stopped
bool confirmed_empty_and_clear
---
bool accepted
string state
string code
string diagnostic
