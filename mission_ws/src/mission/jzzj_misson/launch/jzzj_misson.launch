<launch>
  <arg name="auto_start" default="false" />
  <arg name="target_color" default="" />
  <arg name="enable_visual_servo" default="false" />

  <include if="$(arg enable_visual_servo)"
           file="$(find jzzj_visual_servo)/launch/jzzj_visual_servo.launch">
    <arg name="target_color" value="$(arg target_color)" />
  </include>

  <group ns="jzzj_misson">
    <rosparam command="load"
              file="$(find jzzj_misson)/params/mission.yaml"
              ns="jzzj_misson_node" />
    <param name="jzzj_misson_node/auto_start" value="$(arg auto_start)" />
    <param name="jzzj_misson_node/target_color" value="$(arg target_color)" />

    <node pkg="jzzj_misson"
          type="jzzj_misson_node.py"
          name="jzzj_misson_node"
          output="screen" />
  </group>
</launch>
